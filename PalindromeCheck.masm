ORG 100h

.MODEL SMALL
.STACK 100H

.DATA 
MSG1 DB 'ENTER A STRING: $'
MSG2 DB 'LENGTH: $'
MSG3 DB 'PALINDROME$'
MSG4 DB 'NOT A PALINDROME$'
ST DB 30 DUP ('$')  
NEWLINE DB 13,10, '$'
LEN DW 0

.CODE

INPUT MACRO
    MOV DX,OFFSET MSG1
    MOV AH,9
    INT 21H
    MOV SI,0
READ_LOOP:
    MOV AH,1
    INT 21H
    CMP AL,13
    JE DONE_READING_INPUT
    MOV ST[SI],AL
    INC SI
    JMP READ_LOOP
DONE_READING_INPUT:
ENDM

NEW MACRO
    MOV DX,OFFSET NEWLINE
    MOV AH,9
    INT 21H
ENDM

LENGTH MACRO
    MOV LEN,SI
    MOV DX,OFFSET MSG2
    MOV AH,9
    INT 21H
    MOV AX,LEN
    ADD AL,30H
    MOV DL,AL
    MOV AH,2
    INT 21H
ENDM

PALIN_CHECK MACRO
    MOV SI,0
    MOV DI,LEN
    DEC DI
PAL_LOOP:
    MOV AL,ST[SI]
    MOV BL,ST[DI]
    CMP AL,BL
    JNE NOT_PALI
    INC SI
    DEC DI
    CMP SI,DI
    JAE IS_PALI
    JMP PAL_LOOP
IS_PALI:
    MOV DX,OFFSET MSG3
    MOV AH,9
    INT 21H
    JMP EXIT_PROG
NOT_PALI:
    MOV DX,OFFSET MSG4
    MOV AH,9
    INT 21H
EXIT_PROG:
ENDM

MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    INPUT
    NEW
    LENGTH
    NEW
    PALIN_CHECK

    MOV AH, 4CH
    INT 21H
MAIN ENDP

END MAIN
